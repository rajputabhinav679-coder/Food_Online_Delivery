# Copy this file to .streamlit/secrets.toml for local use.
# On Streamlit Community Cloud, paste these sections into App -> Settings -> Secrets.
# NEVER upload the real secrets.toml to GitHub or share it publicly.

[email]
# Gmail account used to SEND application notifications.
# This may be the same Gmail address as [auth].cafe_email.
sender = "your-cafe-sender@gmail.com"

# Gmail App Password (not the normal Gmail account password).
# Enable 2-Step Verification first, then create an App Password.
app_password = "xxxx xxxx xxxx xxxx"

# Optional: use this only if order alerts should go to a different inbox.
# If omitted, notifications go to [auth].cafe_email (then to the Cafe Owner
# account's database e-mail as a fallback).
# cafe_email = "actual-cafe-owner@gmail.com"

# Optional SMTP / app details.
# smtp_host = "smtp.gmail.com"
# smtp_port = 587
# app_url = "https://your-app.streamlit.app"

[auth]
# Cafe Owner login e-mail. This is also the default new-order alert recipient.
cafe_email = "actual-cafe-owner@gmail.com"

# Create a separate app login password. Do NOT use the Gmail password here.
cafe_password = "Choose-a-strong-app-login-password"

cafe_name = "Cafe Owner"
cafe_phone = ""

# [auth]
# cafe_email = "owner@gmail.com"
# cafe_password = "first-password"        # used only when the owner account is first created
# reset_cafe_password = true              # set true for ONE start to force this password again (lost password)

